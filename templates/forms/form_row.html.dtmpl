{if:field.type=`fieldset`}
    {include:`forms/fieldset.html.dtmpl`}
{endif}
{unless:field.type=`fieldset`}
    {unless:field.type=`submit`}
        <div{loop:field.row_attr} {var:item.key}="{var:item.value}"{endloop}>
            {unless:field.type=`checkbox`}
                <label for="{var:field.id}"{loop:field.label_attr} {var:item.key}="{var:item.value}"{endloop}>
                    {var:field.label}{if:field.required} <span aria-hidden="true">*</span>{endif}
                </label>
            {endunless}
            {include:`forms/input.html.dtmpl`}
            {if:field.type=`checkbox`}
                <label for="{var:field.id}"{loop:field.label_attr} {var:item.key}="{var:item.value}"{endloop}>
                    {var:field.label}
                </label>
            {endif}
            {include:`forms/errors.html.dtmpl`}
        </div>
    {endunless}
    {if:field.type=`submit`}
        <div{loop:field.row_attr} {var:item.key}="{var:item.value}"{endloop}>
            {include:`forms/submit.html.dtmpl`}
        </div>
    {endif}
{endunless}

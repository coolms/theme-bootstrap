{comment}
  A password field never renders a value. Its minimum and maximum length are the definition's constraints, the
  browser's own pre-check; the server decides. The show/hide button is hidden until its script runs; its two labels
  are the server's, in the page's language.
{endcomment}
<div class="mb-3">
    <label for="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}" class="form-label">{var:field.label}{if:field.required} <span class="text-danger">*</span>{endif}</label>
    <div class="input-group{if:field.errors} has-validation{endif}">
        <input type="password" class="form-control{if:field.errors} is-invalid{endif}"
               id="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}" name="{var:field.alias}"
               {if:field.required}required{endif} autocomplete="{if:field.autocomplete}{var:field.autocomplete}{else}current-password{endif}"{include:`forms/field/constraints.html.dtmpl`}{include:`forms/field/described.html.dtmpl`}>
        {if:field.revealLabel}<button type="button" class="btn btn-outline-secondary" data-password-reveal="{var:field.id}" aria-controls="{var:field.id}"
                aria-pressed="false" aria-label="{var:field.revealLabel}"
                data-reveal-label="{var:field.revealLabel}" data-conceal-label="{var:field.concealLabel}" hidden>{var:field.revealLabel}</button>{endif}
    </div>
    {include:`forms/field/errors.html.dtmpl`}
    {if:field.hint}<div class="form-text" id="{var:field.id}-hint">{var:field.hint}</div>{endif}
</div>
{if:field.revealLabel}<script src="/site-scripts/password-reveal.js" defer></script>{endif}

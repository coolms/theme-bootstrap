<div class="mb-3{loop:field.errors} is-invalid{endloop}">
    <label for="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}" class="form-label">{var:field.label}{if:field.required} <span class="text-danger">*</span>{endif}</label>
    <input type="password" class="form-control{loop:field.errors} is-invalid{endloop}"
           id="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}" name="{var:field.alias}"
           {if:field.required}required{endif} autocomplete="{if:field.autocomplete}{var:field.autocomplete}{else}current-password{endif}">
    {include:`forms/field/errors.html.dtmpl`}
    {if:field.hint}<div class="form-text">{var:field.hint}</div>{endif}
</div>

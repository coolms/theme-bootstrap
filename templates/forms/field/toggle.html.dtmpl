<div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" id="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}"
           name="{var:field.alias}" value="1"{if:field.value} checked{endif}>
    <label class="form-check-label" for="{if:field.id}{var:field.id}{else}{var:field.alias}{endif}">{var:field.label}</label>
    {include:`forms/field/errors.html.dtmpl`}
</div>

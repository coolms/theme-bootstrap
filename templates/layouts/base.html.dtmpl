<!doctype html>
<html lang="{var:content.locale default=`en`}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{var:page.meta.title default=`CoolMS`}</title>
    {if:page.meta.description}
        <meta name="description" content="{var:page.meta.description}">
    {endif}
    {loop:site.theme.css}
        <link rel="stylesheet" href="{var:item.url}">
    {endloop}
    {slot:head}
    {comment}
      The `{css}` declared by the partials this page reaches, gathered before
      the render and written once. Last in the head so a partial's own rules
      outrank the theme's general ones on a tie -- see the same block in
      `theme-coolms-site`.
    {endcomment}
    {var:_assets.css}
</head>
<body>
    {slot:body}
        <main>
            {slot:content}
        </main>
    {endslot}
    {loop:site.theme.js}
        <script src="{var:item.url}" defer></script>
    {endloop}
    {var:_assets.js}
    {slot:scripts}
</body>
</html>
